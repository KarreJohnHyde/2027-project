# MedTwin environment template (placeholders only; never commit real secrets).
# Copy this file to .env for Docker Compose, then replace required values.

# Backend runtime
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=127.0.0.1
MEDTWIN_BACKEND_PORT=8000
MEDTWIN_FRONTEND_PORT=5173

# Docker Compose uses its persistent /data volume by default. Override this only
# when deliberately connecting to another database.
DATABASE_URL=sqlite:////data/medtwin.db
# DATABASE_URL=postgresql://medtwin_user:replace-me@database:5432/medtwin_db

# Security and authentication
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Development seed data is opt-in. When enabled, provide a local-only password;
# the backend must never ship or fall back to a password embedded in source.
DEV_SEED_ENABLED=false
DEV_SEED_USERNAME=
DEV_SEED_PASSWORD=
DEV_SEED_EMAIL=
DEV_SEED_FULL_NAME=MedTwin Development User
DEV_SEED_ROLE=clinician
DEV_SEED_CASE_ENABLED=false

# File storage
UPLOAD_DIR=/data/uploads
# 25 MiB
MAX_UPLOAD_SIZE_BYTES=26214400

# Mathematical gates (research defaults, not clinically validated thresholds)
TAU_TRE_THRESHOLD_DEFAULT=5.0
L_MIN_OBSERVATIONS=3
CALIBRATION_TEMPERATURE=1.15

# Browser/API routing
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8443","http://127.0.0.1:8443"]
# Vite's development proxy target; this is not exposed to browser bundles.
MEDTWIN_BACKEND_URL=http://127.0.0.1:8000
# Leave blank for same-origin production traffic through nginx /api/v1.
VITE_MEDTWIN_API_URL=

# Supabase browser client (src/lib/supabase/client.ts). Put real values in
# .env.local; only the project URL and the publishable key belong in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
