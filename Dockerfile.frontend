FROM node:22-alpine AS build

WORKDIR /app
COPY package*.json ./
RUN npm ci

COPY . .
ARG VITE_MEDTWIN_API_URL=""
ENV VITE_MEDTWIN_API_URL=${VITE_MEDTWIN_API_URL}
# `npm run check` compiles into .cache/build-check (no public assets); the image needs the production dist.
RUN npm run typecheck && npm run lint && npm run build

# Runs as the unprivileged nginx user (uid 101) and listens on 8080.
FROM nginxinc/nginx-unprivileged:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY nginx-security-headers.conf /etc/nginx/snippets/security-headers.conf
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://127.0.0.1:8080/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
