# Closed allowlist of what a deployment uploads. A Vercel CLI deploy from the working
# repository would otherwise send local datasets, the development database and uploads;
# Git deployments see only the published snapshot. Nothing here grants deployment permission.
**
!vercel.json
!.vercelignore
!package.json
!package-lock.json
!index.html
!vite.config.ts
!tsconfig.json
!tsconfig.app.json
!tsconfig.node.json
!.figma/
!.figma/make/
!.figma/make/site.json
!src/
!src/**
!scripts/
!scripts/start-vite.mjs
!scripts/vercel-config.test.mjs
!public/
!public/favicon.svg
!public/icons.svg
!public/anatomy/
!public/anatomy/manifest.json
!public/anatomy/atlas-index.json
# The simplified reference models and their attribution, already published in the repository.
!public/models/
!public/models/registry.json
!public/models/ATTRIBUTION.md
!public/models/medtwin_l1_*.glb
!backend/
!backend/pyproject.toml
!backend/uv.lock
!backend/vercel_build.py
!backend/requirements.txt
!backend/app/
!backend/app/**
# Generated evidence the API reads; vercel_build.py stages it into the backend bundle.
!dataset_registry/
!dataset_registry/datasets.json
!dataset_registry/tasks.json
!model_registry/
!model_registry/*.json
!docs/
!docs/research/
!docs/research/traceability.json
!docs/validation/
!docs/validation/*.json
!docs/validation/models/
!docs/validation/models/*.json
!docs/anatomy/
!docs/anatomy/derivatives.json
!docs/deployment/
!docs/deployment/VERCEL_SERVICES.md
!benchmarks/
!benchmarks/results/
!benchmarks/results/*.json

# Never uploaded, whatever the entries above allow.
**/.env
**/.env.*
**/__pycache__/**
**/*.pyc
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite3
**/*.key
**/*.pem
**/*.pt
**/*.pth
**/*.onnx
**/*.safetensors
public/anatomy/derived/**
backend/uploads/**
backend/storage/**
backend/runtime/**
backend/deployment_files/**
artifacts/**
_imports/**
_derived/**
